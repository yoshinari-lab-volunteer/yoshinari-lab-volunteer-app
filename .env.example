# Firebase Web アプリの設定値（Firebaseコンソール > プロジェクトの設定 > 全般 > マイアプリ）
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=xxxxx.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=xxxxx
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:xxxxxxxxxxxx

# firebase-admin 用のサービスアカウント（Firebaseコンソール > プロジェクトの設定 > サービスアカウント）
# 絶対に NEXT_PUBLIC_ を付けないこと（サーバー専用のシークレット）
FIREBASE_PROJECT_ID=xxxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@xxxxx.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 画像保存 (https://cloudinary.com、無料枠・クレカ登録不要。詳細は docs/CLOUDINARY_SETUP.md)
# CLOUDINARY_API_SECRET は絶対に NEXT_PUBLIC_ を付けないこと（サーバー専用のシークレット）
CLOUDINARY_CLOUD_NAME=xxxxx
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxx

# LINEログイン（任意。未設定ならLINE関連のボタンは表示されない。詳細は docs/LINE_SETUP.md）
# LINE_CHANNEL_SECRET は絶対に NEXT_PUBLIC_ を付けないこと（サーバー専用のシークレット）
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# ログイン時に公式アカウントの友だち追加を促す場合のみ（normal / aggressive）
# LINE_BOT_PROMPT=normal

# 管理者への通知メール (https://resend.com、Resend登録時のメールアドレス宛のみ無料で送信可)
RESEND_API_KEY=re_xxxxxxxxxxxx
ADMIN_NOTIFICATION_EMAIL=admin@example.com
MAIL_FROM=ボランティアアプリ <onboarding@resend.dev>

# 退会問い合わせ先（mailto リンクに使用）
NEXT_PUBLIC_CONTACT_EMAIL=admin@example.com

# メール内のリンク生成に使用。本番は Vercel のドメイン
NEXT_PUBLIC_SITE_URL=http://localhost:3000
