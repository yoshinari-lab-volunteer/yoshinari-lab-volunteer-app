# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# RLS を無視する管理者キー。サーバー専用。絶対に NEXT_PUBLIC_ を付けないこと
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 管理者への通知メール (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxx
ADMIN_NOTIFICATION_EMAIL=admin@example.com
MAIL_FROM=ボランティアアプリ <onboarding@resend.dev>

# 退会問い合わせ先（mailto リンクに使用）
NEXT_PUBLIC_CONTACT_EMAIL=admin@example.com

# メール内のリンク生成に使用。本番は Vercel のドメイン
NEXT_PUBLIC_SITE_URL=http://localhost:3000
